# /var/www/testik/.env.local on the Beget server. Never commit this file.

NEXT_PUBLIC_SITE_URL=https://testik.ru
AUTH_URL=https://testik.ru
AUTH_SECRET=

# Postgres on the same VPS (setup-server.sh fills this in)
DATABASE_URL=

# --- Site owner (shown in the footer, privacy policy, consent and terms; required by 149-ФЗ and 152-ФЗ)
# optional: defaults to the owner's details in src/lib/legal.ts
OPERATOR_NAME=
OPERATOR_EMAIL=
# optional: ИНН (if you are self-employed / ИП) and a postal address for data requests
OPERATOR_INN=
OPERATOR_ADDRESS=

# --- Sign-in (Russian ID services only, 149-ФЗ ред. 406-ФЗ)
# VK ID: https://id.vk.com/about/business/go  -> redirect URL https://testik.ru/api/auth/callback/vk
AUTH_VK_ID=
AUTH_VK_SECRET=
# Yandex ID: https://oauth.yandex.ru  -> redirect URL https://testik.ru/api/auth/callback/yandex
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=

# Email magic links stay off (not an allowed sign-in method for Russian users). Set to 1 only after legal review.
AUTH_EMAIL_ENABLED=
EMAIL_SERVER=
EMAIL_FROM=

# --- Analytics: Yandex Metrica only (loads after cookie consent; data stays in Russia)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

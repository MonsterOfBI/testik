# Public site URL (used for sitemap, OG images, canonical links)
NEXT_PUBLIC_SITE_URL=https://testik.example

# Postgres (Neon / Supabase / Beget). Enables accounts, email sign-in and synced history.
DATABASE_URL=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Yandex ID OAuth app (https://oauth.yandex.ru)
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=
# VK OAuth app (https://id.vk.com/about/business/go)
AUTH_VK_ID=
AUTH_VK_SECRET=
# Magic-link email (SMTP URL), e.g. smtps://user:pass@smtp.yandex.ru:465
EMAIL_SERVER=
EMAIL_FROM=

# Analytics (loaded only after cookie consent)
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=

# Image generation for result illustrations (server-side only, never commit the key)
POLZA_API_KEY=

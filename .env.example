# Public site URL (used for sitemap, OG images, canonical links)
NEXT_PUBLIC_SITE_URL=https://testik.example

# Postgres (Neon / Supabase / Beget). Enables accounts, email sign-in and synced history.
DATABASE_URL=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Public URL of the site, needed behind nginx (e.g. https://testik.ru)
AUTH_URL=
# Yandex ID OAuth app (https://oauth.yandex.ru)
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=
# VK OAuth app (https://id.vk.com/about/business/go)
AUTH_VK_ID=
AUTH_VK_SECRET=
# Magic-link email is off unless AUTH_EMAIL_ENABLED=1 (149-ФЗ allows only Russian ID services for Russian users)
AUTH_EMAIL_ENABLED=
# SMTP URL, e.g. smtps://user:pass@smtp.yandex.ru:465
EMAIL_SERVER=
EMAIL_FROM=

# Analytics: Yandex Metrica only, loaded after cookie consent (Google Analytics was removed: cross-border transfer)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Site owner / personal data operator, shown in the footer and legal pages (149-ФЗ ст. 10, 152-ФЗ ст. 18.1)
OPERATOR_NAME=
OPERATOR_EMAIL=
OPERATOR_INN=
OPERATOR_ADDRESS=

# Image generation for result illustrations (server-side only, never commit the key)
POLZA_API_KEY=
